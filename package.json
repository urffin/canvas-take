{
  "name": "@grundyjs/canvas-take",
  "version": "0.8.0",
  "description": "Record canvas video with audio and export offline H.264/AAC MP4, VP8/Opus WebM, GIF, APNG or animated WebP with pluggable encoders, Worker support and explicit resource cleanup",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "ru/README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/gif-encoder.md",
    "docs/gif-benchmark.md",
    "docs/gif-memory-benchmark.md",
    "docs/gif-preparation-benchmark.md",
    "docs/gif-worker-preparation.md",
    "docs/video-recording.md",
    "docs/offline-video-api.md",
    "docs/offline-video-adapters.md",
    "docs/offline-aac.md",
    "docs/offline-webm.md",
    "docs/apng-export.md",
    "docs/webp-export.md",
    "examples/webp.html",
    "docs/drafts"
  ],
  "exports": {
    "./webp": {
      "types": "./dist/webp.d.ts",
      "import": "./dist/webp.js",
      "default": "./dist/webp.js"
    },
    "./webp/worker": {
      "types": "./dist/webp-worker.d.ts",
      "import": "./dist/webp-worker.js",
      "default": "./dist/webp-worker.js"
    },
    "./webp/worker-runtime": "./dist/webp-worker-runtime.js",
    "./webp/codec.wasm": "./dist/webp-codec.wasm",
    "./apng": {
      "types": "./dist/apng.d.ts",
      "import": "./dist/apng.js",
      "default": "./dist/apng.js"
    },
    "./apng/worker": {
      "types": "./dist/apng-worker.d.ts",
      "import": "./dist/apng-worker.js",
      "default": "./dist/apng-worker.js"
    },
    "./apng/worker-runtime": "./dist/apng-worker-runtime.js",
    "./video/webm": {
      "types": "./dist/video-webm.d.ts",
      "import": "./dist/video-webm.js",
      "default": "./dist/video-webm.js"
    },
    "./video/opus": {
      "types": "./dist/video-opus.d.ts",
      "import": "./dist/video-opus.js",
      "default": "./dist/video-opus.js"
    },
    "./video/aac": {
      "types": "./dist/video-aac.d.ts",
      "import": "./dist/video-aac.js",
      "default": "./dist/video-aac.js"
    },
    "./video/aac-worker": "./dist/video-aac-worker.js",
    "./video/webcodecs": {
      "types": "./dist/video-webcodecs.d.ts",
      "import": "./dist/video-webcodecs.js",
      "default": "./dist/video-webcodecs.js"
    },
    "./video/mp4": {
      "types": "./dist/video-mp4.d.ts",
      "import": "./dist/video-mp4.js",
      "default": "./dist/video-mp4.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js",
      "default": "./dist/video.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "import": "./dist/gif.js",
      "default": "./dist/gif.js"
    },
    "./gif/gifenc": {
      "types": "./dist/gifenc.d.ts",
      "import": "./dist/gifenc.js",
      "default": "./dist/gifenc.js"
    },
    "./gif/worker": {
      "types": "./dist/gif-worker.d.ts",
      "import": "./dist/gif-worker.js",
      "default": "./dist/gif-worker.js"
    },
    "./gif/worker-runtime": "./dist/gif-worker-runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-adapters.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:package": "node scripts/test-package.mjs",
    "test:apng:package": "node scripts/test-apng-package.mjs",
    "test:webp:package": "node scripts/test-webp-package.mjs",
    "test:webp:package:browser": "node scripts/test-webp-package.mjs --browser",
    "test:release-video": "node scripts/test-release-video.mjs",
    "test:next": "node scripts/test-next.mjs",
    "test:next:webp": "node scripts/test-next.mjs --webp-browser",
    "test:browser": "npm run build && playwright test",
    "benchmark:gif": "npm run build && node scripts/benchmark-gif.mjs",
    "benchmark:gif:lifecycle": "npm run build && node scripts/benchmark-gif-lifecycle.mjs",
    "benchmark:gif:preparation": "npm run build && node scripts/benchmark-gif-preparation.mjs",
    "benchmark:gif:worker-preparation": "npm run build && node scripts/benchmark-gif-worker-preparation.mjs"
  },
  "devDependencies": {
    "@mediabunny/aac-encoder": "1.65.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "mediabunny": "1.65.0",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Grundy",
    "url": "https://grundyjs.ru/"
  },
  "homepage": "https://grundyjs.ru/canvas-take/",
  "keywords": [
    "canvas",
    "video",
    "recording",
    "mediarecorder",
    "gif",
    "apng",
    "webp",
    "animated-webp",
    "audio",
    "web-worker",
    "typescript",
    "webcodecs",
    "mp4",
    "aac",
    "webm",
    "vp8",
    "opus",
    "offline-video"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "url": "git+https://github.com/urffin/canvas-take.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/urffin/canvas-take/issues"
  }
}
