{
  "name": "canvas-take",
  "version": "0.1.0",
  "description": "Record HTML canvas to video with explicit resource lifecycle",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Grundy",
    "url": "https://grundyjs.ru/"
  },
  "homepage": "https://grundyjs.ru/algorithms/insertion-sort/",
  "keywords": [
    "canvas",
    "video",
    "recording",
    "mediarecorder",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "url": "git+https://github.com/urffin/canvas-take.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/urffin/canvas-take/issues"
  }
}
