{
  "name": "@grundyjs/canvas-take",
  "version": "0.4.0",
  "description": "Record HTML canvas to video with explicit resource lifecycle",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "ru/README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/gif-encoder.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "import": "./dist/gif.js",
      "default": "./dist/gif.js"
    },
    "./gif/gifenc": {
      "types": "./dist/gifenc.d.ts",
      "import": "./dist/gifenc.js",
      "default": "./dist/gifenc.js"
    },
    "./gif/worker": {
      "types": "./dist/gif-worker.d.ts",
      "import": "./dist/gif-worker.js",
      "default": "./dist/gif-worker.js"
    },
    "./gif/worker-runtime": "./dist/gif-worker-runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-gif.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:package": "node scripts/test-package.mjs",
    "test:next": "node scripts/test-next.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Grundy",
    "url": "https://grundyjs.ru/"
  },
  "homepage": "https://grundyjs.ru/algorithms/insertion-sort/",
  "keywords": [
    "canvas",
    "video",
    "recording",
    "mediarecorder",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "url": "git+https://github.com/urffin/canvas-take.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/urffin/canvas-take/issues"
  }
}
